[Unit]
Description=GBX Announce (keyless periodic NODE/LP re-announce on-chain)
After=goldbrixd.service
[Service]
Type=oneshot
Environment=GBX_CLI=goldbrix-cli
Environment=GBX_NODEREG_WINDOW=200000
Environment=GBX_TOOLSDIR=/opt/goldbrix-tools
ExecStart=/usr/bin/env bash ${GBX_TOOLSDIR}/node-registry/gbx-announce.sh
